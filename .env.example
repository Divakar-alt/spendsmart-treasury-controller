# Airwallex Sandbox API Credentials
# Retrieve from Airwallex Web App > Account > Developer > API keys
AWX_CLIENT_ID=example
AWX_API_KEY=example
AIRWALLEX_API_URL=https://api.sandbox.airwallex.com

# Operation Mode: "sandbox" (real calls to Airwallex sandbox) or "simulator" (deterministic in-memory sandbox engine)
AIRWALLEX_MODE=simulator

# Optional LLM API Key for real-time unstructured evidence reasoning (Gemini / OpenAI / Anthropic)
# If omitted, deterministic rule-based analyst engine executes with 100% precision
GEMINI_API_KEY=
OPENAI_API_KEY=

# Application Port
PORT=3000
